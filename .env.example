# Public website and owner account
SITE_URL=https://classyapparelsbysana.com
OWNER_EMAIL=shop@classyapparelsbysana.com
# Required legal/customer-care details. Checkout stays disabled in production
# until these are complete and truthful.
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
CUSTOMER_CARE_EMAIL=shop@classyapparelsbysana.com
CUSTOMER_CARE_PHONE=+91 77159 10151
GRIEVANCE_OFFICER=
# Example only: "Customer pays return courier for size exchanges; we pay for wrong or damaged items."
EXCHANGE_RETURN_SHIPPING_POLICY=
# Generate a unique random value of at least 32 characters. Keep private.
AUTH_SECRET=replace_with_a_long_random_value

# Dedicated administrator sign-in. This is the only value needed for /admin.
# Generate a unique private value of at least 32 characters and add it only in
# Hostinger's environment settings. Changing it signs out all current admins.
ADMIN_ACCESS_KEY=

# Hostinger MySQL — copy these values from hPanel. Never commit the real password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Business email (Hostinger mailbox SMTP). Use the mailbox/app password, not your hPanel password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shop@classyapparelsbysana.com
SMTP_PASSWORD=
EMAIL_FROM=Classy Apparels by Sana <shop@classyapparelsbysana.com>
# Separate multiple owner recipients with commas.
ORDER_NOTIFICATION_EMAIL=shop@classyapparelsbysana.com

# Permanent product/review photo location. Hostinger must allow this directory to be written.
# The app serves these files securely through /media, so the directory itself need not be public.
UPLOAD_DIR=
UPLOAD_PUBLIC_PATH=/media

# All valid Indian PIN codes are accepted because fulfilment is arranged manually.
# Optional per-PIN rows can still override the shipping fee and delivery estimate.
# For online international checkout, set a reviewed flat charge in paise.
# Leave blank to route international customers to WhatsApp for a manual quote.
INTERNATIONAL_SHIPPING_PAISE=
# Never enable this in production; it exists only for local catalogue demos.
ALLOW_CATALOG_FALLBACK=false

# Razorpay live credentials. Do not add these until you have completed Razorpay verification and a test order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional integrations — leave blank until you connect each one.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
