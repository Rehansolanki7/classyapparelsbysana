{
  "name": "classy-apparels-by-sana",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && NEXT_TEST_WASM_DIR=node_modules/@next/swc-wasm-nodejs next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:migrate": "tsx scripts/migrate-hostinger.ts",
    "test": "npm run test:unit && npm run lint && tsc --noEmit",
    "test:unit": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@next/swc-wasm-nodejs": "16.3.2",
    "drizzle-orm": "0.45.2",
    "jose": "^6.0.12",
    "mysql2": "^3.15.1",
    "next": "16.3.2",
    "nodemailer": "9.0.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "esbuild": "0.28.2",
    "js-yaml": "4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  },
  "type": "module",
  "displayName": "Classy Apparels by Sana"
}
